<html>
<body>

<h1>THN Access Portal</h1>

<input id="chiave" placeholder="THN Key">

<button onclick="entra()">
Entra
</button>

<script>

function entra() {

let inserita =
document.getElementById("chiave").value;

if (
inserita ==
localStorage.getItem("thnkey")
) {

document.write(
"<h1>Benvenuto in THN</h1>"
);

}

else {

alert("Chiave non valida!");

}

}

</script>

</body>
</html>